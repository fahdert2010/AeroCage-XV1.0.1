import tkinter as tk

from core.ui_base import AeroCageUIBase
from core.ui_strike_coordinator import UiStrikeCoordinator

# ─── جلب دالة معالجة اللغة العربية من الملف المنفصل ───
from ui_utils import fix_arabic_text

AVAILABLE_MODULES = {
    "0": "🎯 [ الخيار 0 ]: مركز التقاط واختيار أهداف البث والأكسس",
    "1": "📊 [ الخيار 1 ]: لوحة استطلاع وفحص القنوات والترددات حياً",
    "2": "🔀 [ الخيار 2 ]: جسور الشبكات الافتراضية المعزولة VLAN",
    "3": "💾 [ الخيار 3 ]: منصة حقن وبث تحديثات الفيرموير للراوترات",
    "4": "🔑 [ الخيار 4 ]: حصاد وتلقيم بوابات المصادقة الأمنية",
    "5": "🧠 [ الخيار 5 ]: إدارة وتوزيع مسارات الـ RAM Disk المشفرة",
    "6": "🚀 [ الخيار 6 ]: غرف عمليات الغزو الموجه وحراسة الأثير",
    "7": "⛓️ [ الخيار 7 ]: شاشة رصد سلامة أنفاق الـ SSH العكسية",
    "8": "🧹 [ الخيار 8 ]: صمام التطهير الكلي والانسحاب العتادي الشامل"
}


class AeroCageMasterLauncher(AeroCageUIBase):
    """
    Main Sovereign Dynamic Launcher GUI Dashboard View.
    Generates interface options recursively and handles multi-window scaling.
    """

    def __init__(self, root: tk.Tk):
        """تهيئة اللانشر وتوجيه جينات الأب للثيم الرسومي المتمدد حركياً"""
        # عناوين شريط النافذة العلوي (Title Bar) يفضل تركها طبيعية لأن النظام يشغلها بشكل صحيح
        super().__init__(
            root,
            title="🎮 AeroCage-X: نظام القيادة اللاسلكي الموزع الحركي الموحد",
            width=700,
            height=650
        )
        self.coordinators = {}
        self.build_launcher_interface()

    def build_launcher_interface(self):
        """بناء لوحة الاختيارات الـ 9 الكاملة المتجاوبة مع أبعاد الشاشة"""
        self.root.columnconfigure(0, weight=1)
        self.root.rowconfigure(1, weight=1)

        txt_title = "⚡ AEROCAGE-X: PLUG-AND-PLAY COMPLETE TACTICAL DASHBOARD ⚡"
        lbl_title = tk.Label(self.root, text=txt_title, font=("Courier", 11, "bold"))
        self.apply_cyber_theme(lbl_title, "label")
        lbl_title.grid(row=0, column=0, pady=15, sticky=tk.EW)

        container = tk.Frame(self.root, bg=self.bg_main)
        container.grid(row=1, column=0, padx=30, pady=5, sticky=tk.NSEW)
        container.columnconfigure(0, weight=1)
        container.rowconfigure(0, weight=1)

        canvas = tk.Canvas(container, bg=self.bg_main, highlightthickness=0)
        scrollbar = tk.Scrollbar(container, orient="vertical", command=canvas.yview)
        menu_frame = tk.Frame(canvas, bg=self.bg_main)

        menu_frame.bind(
            "<Configure>",
            lambda e: canvas.configure(scrollregion=canvas.bbox("all"))
        )
        canvas.create_window((0, 0), window=menu_frame, anchor="nw")
        canvas.configure(yscrollcommand=scrollbar.set)

        canvas.grid(row=0, column=0, sticky=tk.NSEW)
        scrollbar.grid(row=0, column=1, sticky=tk.NS)
        menu_frame.columnconfigure(0, weight=1)

        row_idx = 0
        for key, btn_text in AVAILABLE_MODULES.items():
            # 💡 [تعديل]: نقوم بإصلاح نص الخيار العربي قبل تمريره للزر
            sanitized_text = fix_arabic_text(btn_text)
            
            btn_dyn = tk.Button(
                menu_frame,
                text=sanitized_text,
                command=lambda k=key: self.launch_targeted_module_window(k)
            )

            # سحق قيد الأقواس الفائضة C0325 بنقاء حركي مباشر خطي
            alert_mode = key == "6"
            self.apply_cyber_theme(btn_dyn, "button", alert_style=alert_mode)
            btn_dyn.grid(row=row_idx, column=0, pady=6, padx=10, sticky=tk.EW)
            row_idx += 1

        # 💡 [تعديل]: إصلاح نص زر إنهاء الجلسة مباشرة عند الإنشاء
        exit_text_fixed = fix_arabic_text("❌ إنهاء الجلسة وإغلاق المنظومة")
        btn_exit = tk.Button(
            menu_frame, text=exit_text_fixed, command=self.root.quit
        )
        self.apply_cyber_theme(btn_exit, "button")
        btn_exit.grid(row=row_idx, column=0, pady=15, padx=10, sticky=tk.EW)

        # 💡 [تعديل]: إصلاح نص شريط الحالة السفلي (Status Bar)
        status_text_fixed = fix_arabic_text("📥 جاهز، منصة الإقلاع مستعدة لتوجيه الممرات الـ 9...")
        lbl_status = tk.Label(
            self.root, text=status_text_fixed,
            bd=1, relief=tk.SUNKEN, font=("Arial", 10, "bold")
        )
        self.apply_cyber_theme(lbl_status, "label")
        lbl_status.grid(row=2, column=0, sticky=tk.EW)

    def launch_targeted_module_window(self, module_key):
        """بث وإقلاع نافذة منفصلة تماماً عائمة لحماية تشغيل الـ 20 أكسس بالتوازي"""
        print(f"[+] Launcher Context: Spawning isolated window for Option {module_key}")

        sub_window = tk.Toplevel(self.root)

        if module_key == "6":
            coordinator_instance = UiStrikeCoordinator(sub_window)
            coordinator_instance.launch_strike_provisioning_view()
            self.coordinators[module_key] = coordinator_instance
        else:
            sub_window.title(AVAILABLE_MODULES[module_key])
            sub_window.geometry("500x300")
            sub_window.configure(bg=self.bg_main)

            # 💡 [تعديل]: إصلاح النص الداخلي التنبيهي للنوافذ الفرعية غير المكتملة
            sub_text_fixed = fix_arabic_text("⚙️ واجهة مفرزة قيد المراجعة المعمارية والتطهير...")
            lbl = tk.Label(
                sub_window, text=sub_text_fixed,
                font=("Arial", 11, "bold"), bg=self.bg_main, fg=self.fg_primary
            )
            lbl.pack(expand=True)


if __name__ == "__main__":
    root_window = tk.Tk()
    app = AeroCageMasterLauncher(root_window)
    root_window.mainloop()
